{
  "name": "bar-mission-editor",
  "displayName": "Beyond All Reason",
  "description": "Mission and module editors for BAR, rendered by bar-mission-kit serve; the .lua files are the source of truth",
  "version": "0.3.4",
  "publisher": "beyond-all-reason",
  "license": "GPL-2.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "barMission",
          "title": "Beyond All Reason",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "barMission": [
        {
          "type": "webview",
          "id": "barMissionEditor.form",
          "name": "Missions"
        },
        {
          "type": "webview",
          "id": "barMissionEditor.modules",
          "name": "Reference",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "barMissionEditor.open",
        "title": "Beyond All Reason: Open Missions"
      },
      {
        "command": "barMissionEditor.openModules",
        "title": "Beyond All Reason: Open Reference"
      },
      {
        "command": "barMissionEditor.undo",
        "title": "Beyond All Reason: Undo Last Editor Change"
      }
    ],
    "configuration": {
      "title": "Beyond All Reason",
      "properties": {
        "barMissionEditor.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8571",
          "description": "bar-mission-kit serve HTTP address (its --listen flag)"
        },
        "barMissionEditor.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bar-mission-kit binary. Empty uses the one bundled with this extension, then whatever is on PATH."
        },
        "barMissionEditor.writeDir": {
          "type": "string",
          "default": "",
          "description": "Engine write directory, where the editor artifact is published so the in-game panel can read it. Empty auto-detects the usual install locations."
        }
      }
    },
    "keybindings": [
      {
        "command": "barMissionEditor.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == barMissionEditor.form"
      }
    ]
  }
}
